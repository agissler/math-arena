{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notation-guide.schema.json",
  "title": "Guide de notation Math Arena",
  "type": "object",
  "required": ["grading_instruction", "equivalent_notations", "handwriting_ambiguities"],
  "properties": {
    "grading_instruction": {"type": "string", "minLength": 1},
    "equivalent_notations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["meaning", "forms"],
        "properties": {
          "meaning": {"type": "string", "minLength": 1},
          "forms": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "handwriting_ambiguities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
