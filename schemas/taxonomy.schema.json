{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taxonomy.schema.json",
  "title": "Taxonomie Math Arena",
  "type": "object",
  "required": ["levels", "chapters"],
  "properties": {
    "levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "name", "domain"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
